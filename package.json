{
  "name": "bengbeng-bomb",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev --ip 0.0.0.0",
    "dev:phone": "npm run build && wrangler dev --tunnel",
    "seed:leaderboard": "wrangler d1 execute bengbeng-bomb-db --local --file scripts/seed-leaderboard.sql",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "type-check": "tsc -b --pretty false",
    "lint": "eslint .",
    "test": "vitest run",
    "test:worker": "vitest run tests",
    "check": "npm run lint && npm run type-check && npm test && npm run build"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.35",
    "artplayer": "^5.3.0",
    "artplayer-plugin-danmuku": "^5.3.0",
    "qrcode": "^1.5.4",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260829.1",
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@types/node": "^24.3.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "5.0.2",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.5",
    "globals": "17.11.0",
    "jsdom": "26.1.0",
    "typescript": "5.8.3",
    "typescript-eslint": "8.68.0",
    "vite": "7.3.6",
    "vitest": "3.2.7",
    "wrangler": "^4.127.1"
  }
}
