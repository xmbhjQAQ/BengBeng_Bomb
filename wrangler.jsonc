{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bengbeng-bomb",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-08-30",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "CHALLENGE_TTL_HOURS": "48",
    "RESULT_TTL_HOURS": "48",
    "VIDEO_TICKET_TTL_MINUTES": "15",
    "BILIDIRECT_BASE_URL": "https://replace-with-your-bilidirect.example.com",
    "BILIBILI_QN": "80"
  },
  "d1_databases": [{ "binding": "DB", "database_name": "bengbeng-bomb-db", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }],
  "triggers": { "crons": ["17 * * * *"] }
}
