{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bengbeng-bomb",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-08-30",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "CHALLENGE_TTL_HOURS": "48",
    "RESULT_TTL_HOURS": "48",
    "VIDEO_TICKET_TTL_MINUTES": "15",
    "LEADERBOARD_MIN_ATTEMPTS": "5",
    "LEADERBOARD_CACHE_SECONDS": "600",
    "LEADERBOARD_LIMIT": "20",
    "BILIDIRECT_BASE_URL": "https://bilidirect.nagisa.icu",
    "BILIBILI_QN": "80"
  },
  // The default profile is bound to the current production D1. Define
  // `env.staging` separately with its own D1 ID, PUBLIC_ORIGIN and
  // RATE_LIMITER_* bindings before using a staging deployment.
  "d1_databases": [{ "binding": "DB", "database_name": "bengbeng_bomb", "database_id": "ac62916d-399c-405e-acd9-7694b61171f6", "migrations_dir": "migrations" }],
  "triggers": { "crons": ["17 * * * *"] }
}
